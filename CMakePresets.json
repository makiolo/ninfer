{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "product",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NINFER_BUILD_ENGINE": "ON",
        "NINFER_BUILD_APPS": "ON",
        "BUILD_TESTING": "OFF",
        "NINFER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "rtx5090-release",
      "displayName": "RTX 5090 product binaries",
      "inherits": "product",
      "cacheVariables": {
        "NINFER_TARGET": "rtx5090"
      }
    },
    {
      "name": "rtx5090-dev",
      "displayName": "RTX 5090 products, tests and benchmarks",
      "inherits": "rtx5090-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "rtx5090-ops",
      "displayName": "RTX 5090 Core, Artifact and Ops development",
      "inherits": "rtx5090-dev",
      "cacheVariables": {
        "NINFER_BUILD_ENGINE": "OFF",
        "NINFER_BUILD_APPS": "OFF"
      }
    },
    {
      "name": "dgx-spark-release",
      "displayName": "DGX Spark product binaries",
      "inherits": "product",
      "cacheVariables": {
        "NINFER_TARGET": "dgx_spark"
      }
    },
    {
      "name": "dgx-spark-dev",
      "displayName": "DGX Spark products, tests and benchmarks",
      "inherits": "dgx-spark-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "dgx-spark-ops",
      "displayName": "DGX Spark Core, Artifact and Ops development",
      "inherits": "dgx-spark-dev",
      "cacheVariables": {
        "NINFER_BUILD_ENGINE": "OFF",
        "NINFER_BUILD_APPS": "OFF"
      }
    },
    {
      "name": "r9700-release",
      "displayName": "R9700 product binaries",
      "description": "Windows AMD64 and Ninja; VCPKG_ROOT must name the vcpkg root, HIP_PATH the HIP SDK root. SDK Clang requires the MSVC and Windows SDK environment, e.g. a VS x64 developer console.",
      "inherits": "product",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "PATH": "$env{HIP_PATH}/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "NINFER_TARGET": "r9700",
        "CMAKE_PROJECT_ninfer_INCLUDE_BEFORE": "${sourceDir}/cmake/Dependencies.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "OFF",
        "CMAKE_C_COMPILER": "clang.exe",
        "CMAKE_CXX_COMPILER": "clang++.exe",
        "CMAKE_HIP_COMPILER": "clang++.exe"
      }
    },
    {
      "name": "r9700-dev",
      "displayName": "R9700 products, tests and benchmarks",
      "description": "Requires VCPKG_ROOT (vcpkg root), HIP_PATH (HIP SDK root), and the MSVC and Windows SDK environment, e.g. a VS x64 developer console.",
      "inherits": "r9700-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "r9700-ops",
      "displayName": "R9700 Core, Artifact and Ops development",
      "description": "Requires VCPKG_ROOT (vcpkg root), HIP_PATH (HIP SDK root), and the MSVC and Windows SDK environment. Installs only the base host dependencies; no Engine or product support packages.",
      "inherits": "r9700-dev",
      "cacheVariables": {
        "NINFER_BUILD_ENGINE": "OFF",
        "NINFER_BUILD_APPS": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "rtx5090-release",
      "configurePreset": "rtx5090-release"
    },
    {
      "name": "rtx5090-dev",
      "configurePreset": "rtx5090-dev"
    },
    {
      "name": "rtx5090-ops",
      "configurePreset": "rtx5090-ops"
    },
    {
      "name": "dgx-spark-ops",
      "configurePreset": "dgx-spark-ops"
    },
    {
      "name": "dgx-spark-release",
      "configurePreset": "dgx-spark-release"
    },
    {
      "name": "dgx-spark-dev",
      "configurePreset": "dgx-spark-dev"
    },
    {
      "name": "r9700-release",
      "configurePreset": "r9700-release"
    },
    {
      "name": "r9700-dev",
      "configurePreset": "r9700-dev"
    },
    {
      "name": "r9700-ops",
      "configurePreset": "r9700-ops"
    }
  ],
  "testPresets": [
    {
      "name": "rtx5090-dev",
      "configurePreset": "rtx5090-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "rtx5090-ops",
      "configurePreset": "rtx5090-ops",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dgx-spark-ops",
      "configurePreset": "dgx-spark-ops",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dgx-spark-dev",
      "configurePreset": "dgx-spark-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "r9700-dev",
      "configurePreset": "r9700-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "r9700-ops",
      "configurePreset": "r9700-ops",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
